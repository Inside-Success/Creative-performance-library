# Creative Performance Library — environment
# Copy to `.env.local` and fill in. Never commit the real file.

# --- Phase 0, Decision 1: Meta authentication ---------------------------------
# Default is a shared system-user token, pending IT sign-off on the security and
# audit implications. If IT rules for individual user logins instead, see
# src/config/phase0.ts — the auth mode is swappable there.
META_SYSTEM_USER_TOKEN=

# Meta Marketing API version. Bump deliberately; field availability changes.
META_API_VERSION=v21.0

# --- Appointment attribution --------------------------------------------------
# EXACT Meta action_type value(s) that represent a booked appointment, comma
# separated. This is the metric the Phase 0 spec ranks on.
#
# Verified 2026-08-11 against both approved accounts: no action type represents a
# booking, and zero custom conversions are defined. Leave this EMPTY until one of
# the following is true, and the dashboard will rank on cost per lead instead and
# label itself as a proxy:
#
#   1. Someone creates a custom conversion for the booking event in Meta Events
#      Manager. It then appears in insights as offsite_conversion.custom.<id>,
#      and you set that exact string here.
#   2. Appointments come from Hyros instead, in which case this stays empty and
#      the appointment source is wired separately.
#
# Run /phase1 to see the ranked candidate action types.
META_APPOINTMENT_ACTION_TYPES=

# Deprecated substring fallback, honored only when META_APPOINTMENT_ACTION_TYPES
# is empty. Matching by substring is what previously made appointments look
# configured when nothing matched. Prefer exact types above.
# META_APPOINTMENT_ACTION_KEYWORDS=

# --- Phase 0, Decision 2: Dashboard access model ------------------------------
# Default is company-domain SSO. Set the domain that may sign in.
# Leave ACCESS_MODE unset to inherit the default from src/config/phase0.ts.
# ACCESS_MODE=sso-domain
ALLOWED_EMAIL_DOMAIN=insidesuccess.com
CPL_ADMIN_EMAILS=

# Google Workspace SSO. These stay private and must never be committed with real
# values. The app accepts either GOOGLE_CLIENT_* or AUTH_GOOGLE_* names.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# --- Phase 0, Decision 3: Data refresh ----------------------------------------
# Default is a scheduled database sync. Cadence is NOT yet decided — it depends
# on the Meta rate-limit review in Phase 1. This is a PLACEHOLDER for the Phase 2
# sync worker and currently drives NOTHING. Do not quote it as the refresh rate.
SYNC_INTERVAL_HOURS=6
SYNC_TRIGGER_SECRET=
CPL_SYNC_URL=

# Minutes between automatic dashboard refreshes. This one is live behaviour.
# 0 disables auto-refresh entirely; the Refresh button still works.
#
# Keep this long. There is no cache in front of Meta, so each refresh is a full
# live re-query (~20-30s, ~16-20 Graph calls) and EVERY open tab polls on its own
# timer. Meta's rate limit has already been tripped once on these accounts.
# 15 minutes is the practical floor; below that, build the sync layer first.
# Meta's own insights lag by minutes anyway, and these are 30-day rollups that
# barely move between polls.
AUTO_REFRESH_MINUTES=30

# How long the server may serve data/meta-snapshot.json before trying Meta
# again. If refresh fails, the app keeps showing the last successful snapshot
# and labels it as stale instead of blanking the dashboard.
META_CACHE_TTL_MINUTES=35

# Optional absolute path for the snapshot cache. Leave unset locally. On Render
# with a paid persistent disk, set this under the disk mount, for example:
# META_SNAPSHOT_PATH=/var/data/meta-snapshot.json
META_SNAPSHOT_PATH=

# Shared secret so only the scheduler can trigger POST /api/sync.
SYNC_TRIGGER_SECRET=

# --- Phase 0, Decision 4: Segmentation ----------------------------------------
# Default is Meta campaign-name keyword lookup. Hyros stays unconfigured until
# the API spike shows Meta-side mapping is too messy to rely on.
# HYROS_API_KEY=

# Optional Hyros appointment attribution. When HYROS_API_KEY is set and Meta has
# no appointment action type configured, the spike asks Hyros for Facebook ad-level
# attribution and fills appointments from this field.
HYROS_BASE_URL=https://api.hyros.com/v1
HYROS_ATTRIBUTION_MODEL=last_click
HYROS_APPOINTMENT_FIELD=qualified_calls
